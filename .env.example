# ============================================================
# 复现用配置模板（可入库，不含任何真实凭证）
# 用法：复制为根目录 .env.local 后按需填值。
#   Windows:  copy .env.example .env.local
#   Linux/mac: cp .env.example .env.local
# .env.local 命中 .gitignore 的 .env.local 规则，不会被提交。
# 后端通过 application.properties 里的
#   spring.config.import=optional:file:./.env.local[.properties]
# 读入并覆盖同名配置项。
#
# 全部留空也能跑通主流程：留空即视为该通道「未启用」，
# 系统按既有降级链自动切换，并在界面上如实标注实际生效的来源。
# ============================================================

# ---- 官方气象接口（大赛 CRA40 实况 / GOWFS 三小时预报）----
# 地址为组委会随参赛通知下发，本身不是凭证；Token 才是。
WEATHER_REAL_BASE_URL=http://180.149.156.4:8001
WEATHER_REAL_TOKEN=
WEATHER_REAL_OBSERVATION_TIME=202412312000
# 数据源：contest-observation 官方 / open-meteo 公网真实气象（免凭证）/ simulated 离线模拟
WEATHER_SOURCE=contest-observation

# ---- 天地图（底图主通道，服务端类型密钥）----
# 申请：https://console.tianditu.gov.cn/api/key ——「服务端」类型，并把演示机
# 的出口 IP / 域名填入授权白名单，否则上游返回 403/418。
# 支持密钥池（逗号分隔），后端轮转并按 key 各自熔断。
# 留空时 /api/tianditu/** 返回 503，前端按降级链切到其余底图（不报页面错误）。
TIANDITU_KEYS=
TIANDITU_TK=
# 密钥未绑定域名时的兜底 Referer，须是该密钥已授权的域名
TIANDITU_REFERER=
# 瓦片磁盘缓存目录（相对进程工作目录）
TIANDITU_CACHE_DIR=data/tile-cache

# ---- AI 推理通道 ----
# 本地 Ollama（优先，数据不出本机）：ollama pull qwen2.5:14b
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:14b
# 在线兜底 DeepSeek（可选）：key 与 url 必须同时有值才生效，只填一边会被跳过
DEEPSEEK_FALLBACK_KEY=
DEEPSEEK_FALLBACK_URL=https://api.deepseek.com/chat/completions

# ---- 地理编码兜底（越南街道 / 店铺 POI）----
# Nominatim 公共实例需出国际公网；本机若靠代理翻墙，把代理端口填这里，留空则直连。
# 直连失败只影响越南街道联想，中国地名走天地图主通道不受影响。
GEOCODE_NOMINATIM_PROXY=

# ---- 路网与离线瓦片（可全部留默认，不装 PBF 也能跑）----
# GraphHopper 坐标算路开关，默认关闭；开启需提供 OSM PBF 文件
OSM_LOADER_ENABLED=false
OSM_PBF_PATH=data/osm/vietnam.osm.pbf
OSM_GRAPH_CACHE_PATH=data/graph-cache
# 完全离线底图（底图4）的栅格瓦片目录；留空则按 data/osm-tiles 等候选目录探测，
# 都不存在时底图4不可用，前端自动降到其余底图
OSM_TILES_PATH=

# ---- 决策预生成缓存目录 ----
DECISION_CACHE_DIR=decision-cache

# ---- 水运（平陆运河通航观测）----
# mock：比赛/演示阶段，手动推送验证同一接入链路；official：正式接口
WATERWAY_SOURCE=mock
WATERWAY_OFFICIAL_API_BASE=
WATERWAY_OFFICIAL_TOKEN=

# ---- 公网演示护栏 ----
DEMO_GUARD_ENABLED=true
DEMO_GUARD_DENY_OSM=true
DEMO_GUARD_STRICT_LIMIT=20
DEMO_GUARD_NORMAL_LIMIT=180
